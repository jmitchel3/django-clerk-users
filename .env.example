# Required for Clerk API calls and JWT validation.
CLERK_SECRET_KEY=sk_live_replace_me

# Required for the default Clerk webhook view.
CLERK_WEBHOOK_SIGNING_KEY=whsec_replace_me

# Comma-separated values are accepted by django-clerk-users.
CLERK_FRONTEND_HOSTS=https://app.example.com

# Optional runtime tuning.
CLERK_SESSION_REVALIDATION_SECONDS=300
CLERK_CACHE_TIMEOUT=300
CLERK_ORG_CACHE_TIMEOUT=900
CLERK_API_TIMEOUT_MS=10000
CLERK_WEBHOOK_DEDUP_TIMEOUT=45

# Optional read-only release smoke check.
# Set to an existing Clerk user email when running scripts/live_clerk_smoke.py.
CLERK_LIVE_SMOKE_LOOKUP_EMAIL=

# Optional username and password-sync behavior.
CLERK_AUTO_GENERATE_USERNAME=false
CLERK_AUTO_GENERATE_USERNAME_PREFIX=user
CLERK_SYNC_PASSWORDS=true
